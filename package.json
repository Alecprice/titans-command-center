{
  "name":"titans-command-center",
  "version":"1.0.0",
  "private":true,
  "type":"module",
  "scripts":{
    "dev":"node server.mjs",
    "test":"node --test tests/*.test.mjs",
    "audit:content":"node scripts/content-audit.mjs",
    "audit:production":"node scripts/production-regression.mjs",
    "postaudit:production":"node scripts/regular-season-production-regression.mjs && node scripts/health-content-audit-production-regression.mjs && node scripts/market-cache-production-regression.mjs",
    "secret-scan":"node scripts/check-secrets.mjs",
    "syntax-check":"node scripts/check-syntax.mjs",
    "build:cloudflare":"node scripts/build-cloudflare.mjs",
    "verify:cloudflare":"node scripts/check-cloudflare-build.mjs",
    "d1:configure":"node scripts/configure-d1.mjs",
    "d1:migrate":"npx wrangler@4 d1 migrations apply titans-command-center --remote",
    "deploy:cloudflare":"npm run build:cloudflare && npx wrangler@4 deploy",
    "check":"npm test && npm run audit:content && npm run secret-scan && npm run syntax-check && npm run build:cloudflare && npm run verify:cloudflare"
  },
  "engines":{"node":">=20"}
}
