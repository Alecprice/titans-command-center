{
  "name": "titans-command-center",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run secret-scan && npm run syntax-check",
    "import:pbp": "node scripts/import-pbp.mjs",
    "import:history": "node scripts/import-history.mjs",
    "secret-scan": "node scripts/check-secrets.mjs",
