{
  "rewrites": [
    {"source":"/api/health","destination":"/api?route=health"},
    {"source":"/api/provider-health","destination":"/api?route=provider-health"},
    {"source":"/api/data","destination":"/api?route=data"},
    {"source":"/api/player","destination":"/api?route=player"},
    {"source":"/api/analytics","destination":"/api?route=analytics"},
    {"source":"/api/advanced-analytics","destination":"/api?route=advanced-analytics"},
    {"source":"/api/preseason-stats","destination":"/api?route=preseason-stats"},
    {"source":"/api/market-data","destination":"/api?route=market-data"},
    {"source":"/api/odds","destination":"/api?route=odds"},
    {"source":"/api/bluesky-search","destination":"/api?route=bluesky-search"},
    {"source":"/api/espn-scoreboard","destination":"/api?route=espn-scoreboard"},
    {"source":"/api/sync","destination":"/api?route=sync"},
    {"source":"/api/cron-refresh","destination":"/api?route=cron-refresh"}
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"}
      ]
    }
  ],
  "crons": [
    {"path":"/api/cron-refresh","schedule":"15 10 * * *"}
  ]
}
