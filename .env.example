# Server-only. Never commit real values and never prefix these with NEXT_PUBLIC_.
# Production data persistence uses the Cloudflare TITANS_DB D1 binding; no DATABASE_URL is required.
INGEST_SECRET=
CRON_SECRET=
PROPLINE_API_KEY=
ODDS_API_IO_KEY=

# Optional official YouTube media shelf.
# Server-side YouTube Data API v3 key only. The IFrame Player API itself does not require a key.
YOUTUBE_API_KEY=

# Optional free ticket price providers.
# The Ticket Finder checks every configured provider in parallel and sorts by the lowest reported starting price.
# SeatGeek developer API: free key; official Titans single-game marketplace.
SEATGEEK_CLIENT_ID=
SEATGEEK_AID=
# Ticketmaster Discovery API: free developer key.
TICKETMASTER_API_KEY=
# StubHub public event API: application-only OAuth after API/affiliate approval.
STUBHUB_CLIENT_ID=
STUBHUB_CLIENT_SECRET=

# Optional Fan Hub event discovery. All credentials stay server-side.
# Eventbrite authenticated API requests use a Private Token / OAuth access token, not a browser-exposed app key.
EVENTBRITE_PRIVATE_TOKEN=
# Optional comma-separated organization IDs. If omitted, the server asks Eventbrite which organizations the token can access.
EVENTBRITE_ORGANIZATION_IDS=
# Skiddle API key. Current public API guidance is non-commercial by default; obtain written approval before commercial use.
# Public Skiddle results must retain Skiddle name/logo attribution and the direct event URL returned by the API.
SKIDDLE_API_KEY=
# Fixed, bounded event-radar scope. These may also be stored as Worker secrets/vars instead of committed defaults.
FAN_EVENTS_REGION_LABEL=Nashville, TN
FAN_EVENTS_LAT=36.1665
FAN_EVENTS_LON=-86.7713
FAN_EVENTS_RADIUS_MILES=25
FAN_EVENTS_LOOKAHEAD_DAYS=30
FAN_EVENTS_LIMIT=18

# Home social/news pulse uses free public sources only:
# Tennessee Titans RSS, Bluesky public API, and Reddit RSS.
# No social API credential is required.

# Optional free-provider tuning.
PROPLINE_BOOKS=
PROPLINE_EXTRA_MARKETS=
ODDS_API_IO_BOOKS=
ODDS_CACHE_SECONDS=300

# Historical importer defaults retained for archival tooling only.
TITANS_HISTORY_START=1999
TITANS_HISTORY_END=2026
CONTINUE_ON_IMPORT_ERROR=false
