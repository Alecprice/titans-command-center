{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "titans-command-center",
  "main": "cloudflare/production-worker.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "secrets": {
    "required": ["DATABASE_URL"]
  },
  "vars": {
    "NEON_WAREHOUSE_DISABLED": "true"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": [
      "*/3 * * * *",
      "15 10 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "TITANS_DB",
      "database_name": "titans-command-center",
      "database_id": "1d17912f-45f1-4c3d-8aa9-54f677a37aea",
      "migrations_dir": "db/d1/migrations"
    }
  ]
}
